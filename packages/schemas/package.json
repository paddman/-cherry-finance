{
  "name": "@cherryfin/schemas",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "default": "./dist/api/index.js"
    },
    "./db": {
      "types": "./src/db/index.ts",
      "default": "./dist/db/index.js"
    },
    "./jobs": {
      "types": "./src/jobs.ts",
      "default": "./dist/jobs.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  }
}
