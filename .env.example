# Core runtime
NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=0.2.0
API_PORT=3000
MODEL_GATEWAY_PORT=3100
DEMO_APP_ENABLED=true
DEMO_ALLOWED_ORIGIN=http://localhost:3000

# PostgreSQL
POSTGRES_DB=cherryfin
POSTGRES_USER=cherryfin
POSTGRES_PASSWORD=change-this-in-real-environments
DATABASE_URL=postgres://cherryfin:change-this-in-real-environments@postgres:5432/cherryfin

# Redis / BullMQ
REDIS_URL=redis://redis:6379/0
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=25
ATTACHMENT_CONCURRENCY=2

# MinIO / S3-compatible private object storage
MINIO_ROOT_USER=cherryfin
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORAGE_ENDPOINT=http://minio:9000
# URL embedded in browser-facing presigned uploads. Set this to the host users can reach.
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=cherryfin-private
OBJECT_STORAGE_ACCESS_KEY=cherryfin
OBJECT_STORAGE_SECRET_KEY=change-this-minio-password
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_UPLOAD_TTL_SECONDS=600

# API authentication
# development: trusts x-user-id and falls back to DEV_USER_ID
# jwt: requires an ES256 public key and verifies Bearer tokens
AUTH_MODE=development
DEV_USER_ID=018f0000-0000-7000-8000-000000000001
DEV_USER_EMAIL=developer@cherryfin.local
DEV_USER_DISPLAY_NAME=CherryFin Developer
JWT_PUBLIC_KEY_PEM=
JWT_ISSUER=cherryfin
JWT_AUDIENCE=cherryfin-api

# Internal services
MODEL_GATEWAY_URL=http://model-gateway:3100
API_INTERNAL_URL=http://api:3000
INTERNAL_API_KEY=replace-with-a-long-random-value
READINESS_TIMEOUT_MS=2000

# Local OpenAI-compatible model routes
LOCAL_CHAT_COMPLETIONS_URL=http://host.docker.internal:8000/v1/chat/completions
LOCAL_CHAT_MODEL=qwen-local-chat
LOCAL_SYNTHESIS_COMPLETIONS_URL=http://host.docker.internal:8000/v1/chat/completions
LOCAL_SYNTHESIS_MODEL=qwen-local-synthesis
LOCAL_VISION_COMPLETIONS_URL=http://host.docker.internal:8001/v1/chat/completions
LOCAL_VISION_MODEL=local-vision
LOCAL_MODEL_API_KEY=
MODEL_TIMEOUT_MS=90000
MAX_INLINE_IMAGE_BYTES=6000000

# Optional hosted fallback. The gateway permits it only for public synthesis.
HOSTED_SYNTHESIS_COMPLETIONS_URL=
HOSTED_SYNTHESIS_MODEL=
HOSTED_MODEL_API_KEY=
UPSTREAM_TIMEOUT_MS=60000

# Malware scanning
# development performs an EICAR guard only. Production config rejects this mode.
# For a production-like local run: docker compose --profile security up -d
# and set SCAN_MODE=clamav.
SCAN_MODE=development
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
